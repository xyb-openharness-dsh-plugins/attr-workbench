{
  "name": "@xyb-community/attr-workbench",
  "version": "0.3.0",
  "description": "本机优先的 ATTR 型别确认、心脏与神经受累记录、治疗耐受与家族筛查准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "demo/build-demo-data.mjs",
    "lib",
    "public",
    "schema",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "build:version": "ATTR_CHANNEL=beta node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:package": "node scripts/check-workbench-package.mjs .",
    "check:columns": "node scripts/check-demo-columns.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "ATTR_CHANNEL=beta node scripts/build-version.mjs --check && node scripts/build-client.mjs --check && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-version.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-attr.mjs .",
    "pack:check": "npm pack --dry-run",
    "check:install": "node scripts/check-install.mjs",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "probe:install": "node scripts/probe-install.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/attr-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
